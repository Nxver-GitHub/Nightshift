# The kit is public. Never commit a generated brain or any real data into it.
# Real brains are generated in a SIBLING folder (../<name>-brain), outside this repo.
# These root-anchored patterns are a safety net for anything created inside the repo by mistake.
# (Leading slash = root-only, so they do NOT catch examples/acme-brain — the shipped demo.)
/brain/
/*-brain/

# Secrets — never, ever
.env
.env.local
.env.*
*.key
*.pem
secrets/

# Python cruft
__pycache__/
*.pyc

# Runtime state that must never be committed (generated at the founder's install, not in the kit)
*.db
.taskrunner.on
.taskrunner.lock
*.log

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
node_modules/

# graphify — the codebase knowledge graph.
# graph.json / graph.html / GRAPH_REPORT.md ARE committed: they map this repo for
# any agent onboarding to it. Everything else is machine-specific or regenerable.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/.graphify_*
.playwright-mcp/

# Superserve runtime block: sandbox credentials + pulled VM state (never committed)
blocks/runtime/code/.superserve-state.json
blocks/runtime/code/mirror/

# runtime lock files (fcntl coordination, never content)
*.jsonl.lock
blocks/taskrunner/code/tasks.json.lock
